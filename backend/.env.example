DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_password@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
AGENT_MODE=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
BASELINE_WINDOW_DAYS=7

# Alerts Streaming & Outbound Notifications
ALERTS_CHANNEL=sentinel:alerts
NOTIFIER_MIN_TIER=Critical
DASHBOARD_BASE_URL=http://localhost:5173

